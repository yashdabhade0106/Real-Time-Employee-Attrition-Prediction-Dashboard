# Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit the .env file

# === Application ===
APP_ENV=development
APP_PORT=7860
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-random-string

# === Database ===
DATABASE_URL=sqlite:///data/app.db

# === Authentication ===
# Argon2 time cost (higher = more secure, slower)
AUTH_TIME_COST=3
AUTH_MEMORY_COST=65536
AUTH_PARALLELISM=4

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# === Model ===
MODEL_VERSION=v1.0.0
MODEL_DIR=models

# === RetentionAI Assistant (Optional) ===
# HF_API_TOKEN=hf_your_token_here
# RETENTION_AI_ENABLED=false
# RETENTION_AI_TIMEOUT=30

# === Monitoring ===
DRIFT_ALERT_THRESHOLD=0.2
PREDICTION_LOG_RETENTION_DAYS=90

# === Feature Flags ===
FASTAPI_ENABLED=false
BATCH_SCORING_ENABLED=true
EXPORT_ENABLED=true

# === Privacy ===
MIN_GROUP_SIZE=5
HASH_SALT=change-me-to-a-random-salt

